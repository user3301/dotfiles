{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto"
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    {
      "type": "wm",
      // WSLg's detected version can contain newlines that overwrite the logo.
      "format": "{pretty-name}{?protocol-name} ({protocol-name}){?}{?plugin-name} (with {plugin-name}){?}"
    },
    "cpu",
    "gpu",
    "memory",
    "disk",
    "weather",
    "break",
    "colors"
  ]
}
